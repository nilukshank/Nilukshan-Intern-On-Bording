        <mxCell id="queue" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;strokeWidth=2;shape=cube;boundedLbl=1;size=14;darkOpacity=0.05;darkOpacity2=0.1;fillColor=#5A2E05;strokeColor=#E8952E;" value="&lt;b style=&quot;font-size:17px&quot;&gt;Queue&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BFD3E6&quot;&gt;Azure Service Bus&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#93A4B8&quot;&gt;Buffers digest + notification&lt;br&gt;jobs (queued work)&lt;/font&gt;" vertex="1">
