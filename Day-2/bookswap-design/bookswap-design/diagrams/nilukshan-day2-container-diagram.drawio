<mxfile host="app.diagrams.net" agent="bookswap-generator">
  <diagram id="bookswap-c4-l2" name="Container diagram (C4 L2)">
    <mxGraphModel dx="3211" dy="1709" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1620" pageHeight="1195" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#1B2431;" value="&lt;font style=&quot;font-size:32px&quot;&gt;&lt;b&gt;BookSwap&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#1B6FD1&quot; style=&quot;font-size:18px&quot;&gt;&lt;b&gt;Container diagram &amp;#8212; C4 Level 2&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#4A5567&quot; style=&quot;font-size:13px&quot;&gt;Neighbourhood book-swapping platform on Microsoft Azure&lt;br&gt;container-diagram.drawio &amp;#183; v1.0 &amp;#183; 28 Jul 2026&lt;/font&gt;" vertex="1">
          <mxGeometry height="115" width="560" x="71" y="99" as="geometry" />
        </mxCell>
        <mxCell id="legend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#F4F6F9;strokeColor=#C3CCD8;fontColor=#4A5567;fontSize=13;" value="&lt;b style=&quot;font-size:18px&quot;&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#1B6FD1&quot;&gt;&lt;b&gt;&amp;#9473;&amp;#9473;&amp;#9473;&amp;#9654; solid blue&lt;/b&gt;&lt;/font&gt; = SYNCHRONOUS call; the caller waits for the reply.&lt;br&gt;&lt;font color=&quot;#D97706&quot;&gt;&lt;b&gt;&amp;#9548;&amp;#9548;&amp;#9548;&amp;#9654; dashed orange&lt;/b&gt;&lt;/font&gt; = ASYNCHRONOUS message; the sender does not wait.&lt;br&gt;&lt;br&gt;Container box = &lt;b&gt;name &amp;#183; technology &amp;#183; responsibility&lt;/b&gt;.&lt;br&gt;Dark grey box = person. The member only ever calls the mobile app.&lt;br&gt;Purple box = managed / external service (Entra External ID, ACS).&lt;br&gt;&lt;br&gt;&lt;b&gt;Placement follows decisions/storage-decisions.md:&lt;/b&gt;&lt;br&gt;&amp;#8226; Cache sits in front of Azure SQL on the read path (cache-aside, 60&amp;#8211;300 s TTL); it is never the system of record.&lt;br&gt;&amp;#8226; Queue sits between the API and the digest worker, so slow email work never blocks a member&#39;s request.&lt;br&gt;&lt;br&gt;&lt;b&gt;Every arrow is verb-led and ends with [protocol &amp;#183; sync | ASYNC].&lt;/b&gt;" vertex="1">
          <mxGeometry height="380" width="595" x="1291" y="1327" as="geometry" />
        </mxCell>
        <mxCell id="note0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=8;fillColor=#FBFAF3;strokeColor=#C4A94A;dashed=1;dashPattern=6 4;fontColor=#4A5567;fontSize=12;" value="&lt;b&gt;Read path (cache-aside)&lt;/b&gt;&lt;br&gt;1. The API service reads Redis first.  2. On a miss&lt;br&gt;it reads Azure SQL, then writes the result back with&lt;br&gt;a 60–300 s TTL. Redis is never the system of record,&lt;br&gt;so it has no arrow of its own to Azure SQL." vertex="1">
          <mxGeometry height="120" width="400" x="657" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="member" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;strokeWidth=2;rounded=1;arcSize=8;fillColor=#eeeeee;strokeColor=#36393d;" value="&lt;b style=&quot;font-size:17px&quot;&gt;Member&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BFD3E6&quot;&gt;Person&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#93A4B8&quot;&gt;Neighbour in the building who&lt;br&gt;lends and borrows books&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="280" x="670" y="20" as="geometry" />
        </mxCell>
        <mxCell id="mobile" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontSize=13;strokeWidth=2;rounded=1;arcSize=8;fillColor=#cce5ff;strokeColor=#36393d;" value="&lt;b style=&quot;font-size:17px&quot;&gt;Mobile app&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BFD3E6&quot;&gt;React Native · iOS + Android&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#93A4B8&quot;&gt;Member-facing UI: search,&lt;br&gt;borrow, photos, notifications&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="280" x="670" y="200" as="geometry" />
        </mxCell>
        <mxCell id="identity" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;strokeWidth=2;rounded=1;arcSize=8;fillColor=#2E2350;strokeColor=#8878C7;" value="&lt;b style=&quot;font-size:17px&quot;&gt;Identity&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BFD3E6&quot;&gt;Microsoft Entra External ID&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#93A4B8&quot;&gt;Authenticates members,&lt;br&gt;issues and signs JWTs&lt;/font&gt;" vertex="1">
          <mxGeometry height="125" width="280" x="1640" y="80" as="geometry" />
        </mxCell>
        <mxCell id="api" parent="1" style="whiteSpace=wrap;html=1;verticalAlign=middle;fontColor=#FFFFFF;fontSize=13;strokeWidth=2;rounded=1;arcSize=8;fillColor=#123D24;strokeColor=#3BA36A;" value="&lt;b style=&quot;font-size:17px&quot;&gt;API service&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#BFD3E6&quot;&gt;Node.js Express · App Service&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#93A4B8&quot;&gt;REST API, authorisation,&lt;br&gt;business rules&lt;/font&gt;" vertex="1">
